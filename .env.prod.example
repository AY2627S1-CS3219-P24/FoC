POSTGRES_DB=foc
POSTGRES_USER=foc
POSTGRES_PASSWORD=pass

DOMAIN=localhost
JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem

# MAIL_USERNAME is the mailbox used to sign in. MAIL_FROM is the sender recipients see.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@mail.example.edu
MAIL_PASSWORD=example-app-password
MAIL_FROM=noreply@mail.example.edu
FOC_FRONTEND_URL=https://localhost

INITIAL_ADMIN_EMAIL=admin@u.nus.edu
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_PASSWORD=change-me-admin

# Private image storage. ECS uses the task role; this file does not set access keys.
AWS_REGION=ap-southeast-1
FOC_USER_BUCKET=foc-prod-user
FOC_SUPPLIER_BUCKET=foc-prod-supplier

# SNS topics and consuming queues. Terraform names them <prefix>-<service>-events.
USER_EVENTS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:123456789012:foc-prod-user-events
ORDER_EVENTS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:123456789012:foc-prod-order-events
ORDER_EVENTS_QUEUE_NAME=foc-prod-order-events
CREDIT_EVENTS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:123456789012:foc-prod-credit-events
CREDIT_EVENTS_QUEUE_NAME=foc-prod-credit-events
