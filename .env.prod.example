POSTGRES_DB=foc
POSTGRES_USER=foc
POSTGRES_PASSWORD=

DOMAIN=localhost
JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem

# MAIL_USERNAME is the mailbox used to sign in. MAIL_FROM is the sender recipients see.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@mail.example.edu
FOC_FRONTEND_URL=https://localhost

INITIAL_ADMIN_EMAIL=admin@u.nus.edu
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_PASSWORD=

# Private image storage (runtime services use AWS workload roles in production).
AWS_REGION=ap-southeast-1
FOC_USER_BUCKET=
FOC_SUPPLIER_BUCKET=
