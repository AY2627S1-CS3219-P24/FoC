        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (job) (hikaricp_connections_pending{job=~\"${service:regex}\"})",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "foc",
    "production",
    "micrometer"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "user,supplier,order,credit",
        "multi": true,
        "includeAll": true,
        "allValue": "user|supplier|order|credit",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "user",
            "value": "user"
          },
          {
            "selected": false,
            "text": "supplier",
            "value": "supplier"
          },
          {
            "selected": false,
            "text": "order",
            "value": "order"
          },
          {
            "selected": false,
            "text": "credit",
            "value": "credit"
          }
        ]
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ]
  },
  "timezone": "browser",
  "title": "FoC Services",
  "uid": "foc-services",
  "version": 1
}
