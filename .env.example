POSTGRES_DB=foc
POSTGRES_USER=foc
POSTGRES_PASSWORD=pass

# Gmail SMTP: export these variables to the locally launched User Service too.
# Spring Boot does not automatically load this .env file.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@localhost
FOC_FRONTEND_URL=http://localhost:3000

# Private image storage (runtime services use AWS workload roles in production).
AWS_REGION=ap-southeast-1
FOC_USER_BUCKET=foc-dev-user
FOC_SUPPLIER_BUCKET=foc-dev-supplier

# One-time local admin setup: docker compose run --build --rm admin-init
INITIAL_ADMIN_EMAIL=admin@u.nus.edu
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_PASSWORD=change-me-admin
# Generate keys using docs/containers.md, or point to existing PEM files.
JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
